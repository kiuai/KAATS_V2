# ── Azure AD / Entra ID ────────────────────────────────────────────────────────
AZURE_TENANT_ID=<your-entra-tenant-id>
AZURE_CLIENT_ID=<your-app-registration-client-id>
AZURE_CLIENT_SECRET=<your-app-registration-client-secret>

# ── Azure OpenAI ───────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ── Azure SQL ──────────────────────────────────────────────────────────────────
# Connection string used by SQLAlchemy aioodbc driver
# Format: mssql+aioodbc://user:pass@server/db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
AZURE_SQL_SERVER=sqlserver,1433
AZURE_SQL_DATABASE=kaats
AZURE_SQL_USERNAME=sa
AZURE_SQL_PASSWORD=KaatsDevPass!2026

# ── Azure Cosmos DB ────────────────────────────────────────────────────────────
AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
AZURE_COSMOS_KEY=<your-cosmos-primary-key>
AZURE_COSMOS_DATABASE=kaats

# ── Azure Service Bus ──────────────────────────────────────────────────────────
# Local dev: use the Service Bus Emulator
AZURE_SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=<your-sb>.servicebus.windows.net
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=all;SharedAccessKey=all;UseDevelopmentEmulator=true

# ── Azure Blob Storage ─────────────────────────────────────────────────────────
# Local dev: Azurite default credentials — see https://learn.microsoft.com/azure/storage/common/storage-use-azurite
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_ACCOUNT_KEY=<azurite-default-key>
AZURE_STORAGE_CONTAINER_EVIDENCE=kaats-evidence

# ── Azure Key Vault ────────────────────────────────────────────────────────────
# Leave blank in local dev; secrets are read from environment directly
AZURE_KEY_VAULT_URL=

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=changeme-use-openssl-rand-hex-32-in-production
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=DEBUG

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=60

# ── Agent limits ──────────────────────────────────────────────────────────────
MAX_AGENT_STEPS=50
AGENT_TIMEOUT_SECONDS=1800
AGENT_TOOL_TIMEOUT_SECONDS=30
MAX_CRAWL_PAGES=200

# ── Evidence ──────────────────────────────────────────────────────────────────
EVIDENCE_RETENTION_DAYS=365
